# dcnet configuration (read by bin/dcnet.lua)
#
# root: writable directory for jobs, state, cache, out and logs.
#       Default: /var/lib/dcnet for root, $HOME/.dcnet for other users.
#root=/var/lib/dcnet
#
# transport: rednet (default) | rpv | auto
#       rpv uses unixshell's lib/rpvnet.lua and needs a modem; every node in
#       one cluster must use the same transport.
#transport=rednet
#
# key: shared HMAC key used for message signing and replay protection.
#      Set the same value (8+ characters) on every machine, or leave empty.
#key=
#
# worker_file: worker program the master pushes to nodes with "push".
# Default: <root>/worker.lua, seeded from the package's share/worker.lua.
#worker_file=/var/lib/dcnet/worker.lua
#
# boot: start this role as a background job before the first shell prompt.
#       master | worker | none (default: none)
#boot=master
#
# multishell: 1 (default) = on advanced computers dcnet gets its own tab and
#             ush gets another, instead of dcnet as a background job.
#multishell=1
#
# forward: 1 = the shell is only a command relay; every line is queued for the
#          running master (use "dcnet log" to read its output).
#forward=1
#
# Any scheduler default from dcnet's sched.lua can also be set here, e.g.:
#maxParallel=1
#redundancy=0
#taskTimeout=90
#twoLevelReduce=true
